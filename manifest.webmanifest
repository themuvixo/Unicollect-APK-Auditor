{
  "name": "Unicollect APK Auditor",
  "short_name": "Unicollect",
  "description": "Android APK static security analysis that runs entirely in your browser. Created by muvixo.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16191F",
